# Non-secret local development examples only
#
# Copy to .env.local and fill in real values. .env.local is excluded by .gitignore;
# this template is the only environment file that is committed.
#
# Every credential below is registered in
# docs/07-security/secrets/BOPEN-SEC-VAULT-001.md. Add the registry entry when you add a
# variable here, so the registry stays the single place to look.
#
# Load it:
#   bash        set -a; . ./.env.local; set +a
#   PowerShell  see BOPEN-SEC-VAULT-001.md section 2

BOPEN_ENV=local
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database — CRED-DB-VERIFY-APP
# -----------------------------------------------------------------------------
# Read by platform_kernel.db and by the tenant-isolation suite.
# This role must NOT be a superuser: a superuser bypasses Row-Level Security, and the
# isolation tests would then pass without any policy being enforced.
BOPEN_DATABASE_URL=postgresql://bopen_app:CHANGE_ME@127.0.0.1:5433/bopen_dev

# Retained for compatibility with pre-P35 examples. Prefer BOPEN_DATABASE_URL above;
# nothing in the kernel reads DATABASE_URL.
DATABASE_URL=postgresql://bopen:bopen@localhost:5432/bopen_dev

# -----------------------------------------------------------------------------
# Database admin — CRED-DB-VERIFY-SUPER
# -----------------------------------------------------------------------------
# Superuser connection, used only by tools/db_bootstrap.py to create the database, create
# the application role, and apply migrations. Not read by any runtime code path.
BOPEN_ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/postgres

# Password assigned to the application role by tools/db_bootstrap.py --apply.
# The tool's built-in default is a clearly non-production placeholder; override it here.
BOPEN_APP_PASSWORD=CHANGE_ME

# Set to 1 to permit tools/db_bootstrap.py --rollback, which drops tables that may hold
# audit records. Leave unset on any database you care about.
# BOPEN_DB_NON_PRODUCTION=1

# -----------------------------------------------------------------------------
# Identity and federation — not yet provisioned (WP-P35-03, WP-P35-05)
# -----------------------------------------------------------------------------
# CRED-TOKEN-CONTEXT-SIGNING — Ed25519 private key (PEM, newlines escaped as \n).
# Signs the context access token carrying sub, tid, mid, roles, scopes.
# This is the highest-value secret in the system: forging it defeats every isolation
# control beneath it, including the database policies, without touching the database.
# Generate a development key:  python tools/generate_token_key.py
# Production must source it from an external secret manager (BOPEN-IDP-001 §12.4).
# BOPEN_CONTEXT_TOKEN_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Token issuer and audience. Both are validated on every token; a token minted for another
# bOPEN service must not be replayable against the kernel.
# BOPEN_TOKEN_ISSUER=https://bopen.local/kernel
# BOPEN_TOKEN_AUDIENCE=https://bopen.local/api

# BoxyHQ Jackson client secret for the enterprise SSO bridge.
# BOPEN_JACKSON_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Unauthenticated identity assertions — leave UNSET unless this is a dev machine
# -----------------------------------------------------------------------------
# Phase 1 has no authentication mechanism, so two endpoints act on an identity claim the
# kernel cannot check. Both were confirmed by execution.
#
#   POST /v1/contexts   verifies that a membership exists, belongs to the named principal
#                       and is active, but cannot verify the caller IS that principal — so
#                       three non-secret identifiers yield an owner bearer token.
#
#   POST /v1/tenants    creates a tenant and its owner membership from a principal id the
#                       caller supplies. Naming someone else's principal returns 201: a
#                       tenant exists with a third party bound to it as owner, who never
#                       agreed. It also answers whether a principal id exists, 201 vs 422.
#
# The kernel refuses both unless this affirms the deployment is not production. Setting it on
# anything reachable by a party you would not hand an owner token to is the same as having no
# access control. Resolved by WP-P35-05.
#
# Renamed from BOPEN_ALLOW_UNAUTHENTICATED_CONTEXT on 2026-07-30, when the second endpoint was
# found: the flag is named for the assertion, not for either endpoint, so the next endpoint
# that trusts an unproven identity claim has an obvious place to attach.
# BOPEN_ALLOW_UNAUTHENTICATED_IDENTITY_ASSERTION=1
