{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "verdict",
    "findings",
    "evidence",
    "requiredActions",
    "confidence"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "conditional-pass",
        "fail",
        "decision-required",
        "not-applicable"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "unresolvedQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "title": "bOPEN Skill Authoring and Evaluation Output"
}
