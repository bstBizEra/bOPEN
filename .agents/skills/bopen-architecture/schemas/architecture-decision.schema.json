{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bopen.io/architecture/decision.schema.json",
  "title": "bOPEN Architecture Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "context",
    "decision",
    "rationale",
    "consequences"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "superseded",
        "deprecated",
        "rejected"
      ]
    },
    "context": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "disposition",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "selected",
              "rejected",
              "deferred"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "consequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
