{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bopen.io/schema-diff/evidence-envelope.schema.json",
  "title": "Schema Diff Evidence Envelope",
  "type": "object",
  "required": [
    "evidence_id",
    "created_at",
    "request_id",
    "package",
    "inputs",
    "toolchain",
    "result_digest",
    "redaction_status"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "package": {
      "type": "object",
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "toolchain": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "result_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "raw_output_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "redaction_status": {
      "enum": [
        "not_required",
        "completed",
        "failed"
      ]
    },
    "approval_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
