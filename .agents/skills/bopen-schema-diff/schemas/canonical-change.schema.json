{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bopen.io/schema-diff/canonical-change.schema.json",
  "title": "Canonical Schema Change",
  "type": "object",
  "required": [
    "change_id",
    "object_type",
    "operation",
    "object",
    "classification",
    "engine_findings"
  ],
  "properties": {
    "change_id": {
      "type": "string"
    },
    "object_type": {
      "enum": [
        "schema",
        "table",
        "column",
        "constraint",
        "index",
        "policy",
        "role",
        "grant",
        "function",
        "trigger",
        "view",
        "type",
        "sequence",
        "unknown"
      ]
    },
    "operation": {
      "enum": [
        "create",
        "alter",
        "rename",
        "drop",
        "grant",
        "revoke",
        "enable",
        "disable",
        "unknown"
      ]
    },
    "object": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "before": {
      "type": [
        "object",
        "null"
      ]
    },
    "after": {
      "type": [
        "object",
        "null"
      ]
    },
    "classification": {
      "type": "object",
      "required": [
        "compatibility",
        "data_risk",
        "lock_risk",
        "tenancy_risk",
        "security_risk"
      ],
      "properties": {
        "compatibility": {
          "enum": [
            "compatible",
            "potentially_breaking",
            "breaking",
            "unknown"
          ]
        },
        "data_risk": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "lock_risk": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "tenancy_risk": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "security_risk": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "engine_findings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "required_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
