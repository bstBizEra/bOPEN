    "check:pg-g0-current-tree-readiness": "python tools/report_pg_g0_current_tree_readiness.py --check",
    "report:pg-g0-current-tree-readiness": "python tools/report_pg_g0_current_tree_readiness.py --write",
    "check:pg-g0-bound-tree-readiness": "python tools/report_pg_g0_bound_tree_readiness.py --check",
    "report:pg-g0-bound-tree-readiness": "python tools/report_pg_g0_bound_tree_readiness.py --write",
