{
  "name": "bopen-platform-kernel",
  "version": "0.0.0-bootstrap",
  "private": true,
  "description": "Governed bootstrap for the bOPEN platform kernel",
  "scripts": {
    "validate": "python tools/validate_repository.py && python tools/validate_contracts.py && python tools/validate_research_g3_design.py && python tools/check_clean_room.py && python tools/check_secrets.py && python tools/check_supply_chain.py",
    "check:clean-room": "python tools/check_clean_room.py",
    "check:secrets": "python tools/check_secrets.py",
    "check:supply-chain": "python tools/check_supply_chain.py",
    "test:governance": "python -m unittest discover -s tests/governance -p \"test_*.py\"",
    "test:contracts": "python -m unittest discover -s tests/contracts -p \"test_*.py\"",
    "report:bootstrap-gates": "python tools/report_bootstrap_gates.py",
    "validate:research-g3-design": "python tools/validate_research_g3_design.py",
    "report:research-g3-design": "python tools/report_research_g3_design.py",
    "research:inventory": "python tools/generate_research_artifact_inventory.py",
    "docs:manifest": "python tools/generate_document_manifest.py"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
