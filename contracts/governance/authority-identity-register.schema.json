{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bopen://schemas/governance/authority-identity-register/0.1.0-draft",
  "status": "draft",
  "title": "bOPEN Authority Identity Register",
  "type": "object",
  "required": ["$schema", "register_id", "version", "status", "owner_authority", "updated_at", "approved_by", "approved_at", "approval_ref", "independence_disclosure", "entries"],
  "properties": {
    "$schema": {"const": "bopen://schemas/governance/authority-identity-register/0.1.0-draft"},
    "register_id": {"type": "string", "pattern": "^PG-REG-IDENTITY-[0-9]{3}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-draft)?$"},
    "status": {"enum": ["draft", "approved"]},
    "owner_authority": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "approved_by": {"type": ["string", "null"], "minLength": 1},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "approval_ref": {"type": ["string", "null"], "minLength": 1},
    "independence_disclosure": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/identityRecord"}
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "approved"}}},
      "then": {
        "properties": {
          "approved_by": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "format": "date-time"},
          "approval_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "draft"}}},
      "then": {
        "properties": {
          "approved_by": {"const": null},
          "approved_at": {"const": null},
          "approval_ref": {"const": null}
        }
      }
    }
  ],
  "$defs": {
    "identityRecord": {
      "type": "object",
      "$comment": "identity_id and identity_subject must be identical and match the docket actor role_binding_ref fragment. authority_mode is DIRECT-only in this revision; a delegated-authority record model requires a separate reconciled schema revision.",
      "required": ["identity_id", "status", "display_name", "contact_ref", "human_identity_ref", "identity_provider", "identity_subject", "authority_roles", "authority_mode", "action_ids", "subject_refs", "valid_from", "expires_at", "revoked_at", "evidence_refs"],
      "properties": {
        "identity_id": {"type": "string", "pattern": "^HUMAN-[A-Z0-9][A-Z0-9_-]*$"},
        "status": {"enum": ["pending", "approved", "revoked"]},
        "display_name": {"type": "string", "minLength": 1},
        "contact_ref": {"type": "string", "minLength": 1},
        "human_identity_ref": {"type": "string", "minLength": 1},
        "identity_provider": {"const": "bopen-authority-identity-registry"},
        "identity_subject": {"type": "string", "pattern": "^HUMAN-[A-Z0-9][A-Z0-9_-]*$"},
        "authority_roles": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "authority_mode": {"const": "DIRECT"},
        "action_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}, "minItems": 1, "uniqueItems": true},
        "subject_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "valid_from": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "revoked_at": {"type": ["string", "null"], "format": "date-time"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "approved"}}},
          "then": {
            "properties": {
              "revoked_at": {"const": null}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "revoked"}}},
          "then": {
            "properties": {
              "revoked_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      ]
    }
  }
}
