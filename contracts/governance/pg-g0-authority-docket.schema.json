{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bopen://schemas/governance/pg-g0-authority-docket/0.4.0-draft",
  "status": "draft",
  "title": "bOPEN PG-G0 Authority Docket",
  "type": "object",
  "required": [
    "$schema", "docket_id", "version", "status", "owner_authority",
    "updated_at", "expires_at", "repository_binding", "governing_artifacts",
    "binding_inventory", "authority_source", "technical_review", "prepared_dispositions", "decision_requests", "state",
    "state_history", "effective_outcome", "non_authority_flags", "blockers"
  ],
  "properties": {
    "$schema": {"const": "bopen://schemas/governance/pg-g0-authority-docket/0.4.0-draft"},
    "docket_id": {"type": "string", "pattern": "^PG-G0-AUTH-[0-9]{3}$"},
    "version": {"const": "0.4.0-draft"},
    "status": {"const": "signed_state_candidate"},
    "owner_authority": {"const": "Engineering Authority"},
    "updated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "repository_binding": {"$ref": "#/$defs/repositoryBinding"},
    "governing_artifacts": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifactBinding"}
    },
    "binding_inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["inventory_ref", "inventory_id", "substrate_commit_sha", "substrate_tree_sha", "record_count"],
      "properties": {
        "inventory_ref": {"const": "docs/00-governance/authority-dockets/PG-G0-AUTH-001-V0.4-BINDING-INVENTORY.json"},
        "inventory_id": {"const": "PG-G0-AUTH-001-V0.4-BINDINGS"},
        "substrate_commit_sha": {"$ref": "#/$defs/sha"},
        "substrate_tree_sha": {"$ref": "#/$defs/sha"},
        "record_count": {"type": "integer", "minimum": 1}
      }
    },
    "authority_source": {"$ref": "#/$defs/authoritySource"},
    "technical_review": {"$ref": "#/$defs/technicalReview"},
    "prepared_dispositions": {
      "type": "array", "minItems": 13, "maxItems": 13,
      "items": {"$ref": "#/$defs/preparedDisposition"}
    },
    "decision_requests": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/decisionRequest"}
    },
    "state": {"enum": ["DRAFT", "TECHNICAL_REVIEW", "PENDING_HUMAN_DECISIONS", "READY_FOR_FINAL_DISPOSITION", "DISPOSED", "WITHDRAWN", "EXPIRED", "SUPERSEDED"]},
    "state_history": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/stateHistory"}
    },
    "effective_outcome": {"$ref": "#/$defs/effectiveOutcome"},
    "non_authority_flags": {"$ref": "#/$defs/nonAuthorityFlags"},
    "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repositoryBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["commit_sha", "tree_sha", "branch", "repository_ref"],
      "properties": {
        "commit_sha": {"$ref": "#/$defs/sha"}, "tree_sha": {"$ref": "#/$defs/sha"},
        "branch": {"type": "string", "minLength": 1}, "repository_ref": {"const": "bstBizEra/bopen"}
      }
    },
    "artifactBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "version", "status", "artifact_ref", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1}, "artifact_ref": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authoritySource": {
      "type": "object", "additionalProperties": false,
      "required": ["matrix_id", "artifact_ref", "proposal_ref", "version", "status", "sha256", "signing_ref", "effective"],
      "properties": {
        "matrix_id": {"const": "PG-REG-AUTHORITY-001"},
        "artifact_ref": {"const": "docs/00-governance/registers/AUTHORITY-MATRIX.json"},
        "proposal_ref": {"const": "docs/00-governance/AUTHORITY-MATRIX-0.2.0-PROPOSAL.json"},
        "version": {"const": "0.2.0"}, "status": {"const": "approved"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "signing_ref": {"const": "docs/00-governance/signing/SIGNING-PASS-2.md#append-only-batch-2-signing-record--2026-07-23"},
        "effective": {"const": true}
      }
    },
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_kind", "identity_ref", "role", "registration_ref", "session_ref"],
      "properties": {
        "actor_kind": {"enum": ["HUMAN", "AGENT"]}, "identity_ref": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}, "registration_ref": {"type": ["string", "null"]},
        "session_ref": {"type": ["string", "null"]}
      }
    },
    "technicalReview": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_commit_sha", "candidate_tree_sha", "maker", "checker", "independence_asserted", "verdict", "reviewed_at", "evidence_refs"],
      "properties": {
        "candidate_commit_sha": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "candidate_tree_sha": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "maker": {"$ref": "#/$defs/actor"}, "checker": {"oneOf": [{"$ref": "#/$defs/actor"}, {"type": "null"}]},
        "independence_asserted": {"type": "boolean"},
        "verdict": {"enum": ["PENDING", "ACCEPT_EXACT_SHA", "REQUEST_CHANGES", "REJECT"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"verdict": {"const": "PENDING"}}, "required": ["verdict"]},
          "then": {
            "properties": {
              "candidate_commit_sha": {"type": "null"},
              "candidate_tree_sha": {"type": "null"},
              "checker": {"type": "null"},
              "independence_asserted": {"const": false},
              "reviewed_at": {"type": "null"},
              "evidence_refs": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"verdict": {"const": "ACCEPT_EXACT_SHA"}}, "required": ["verdict"]},
          "then": {
            "properties": {
              "candidate_commit_sha": {"$ref": "#/$defs/sha"},
              "candidate_tree_sha": {"$ref": "#/$defs/sha"},
              "checker": {"$ref": "#/$defs/actor"},
              "independence_asserted": {"const": true},
              "reviewed_at": {"type": "string", "format": "date-time"},
              "evidence_refs": {"minItems": 1}
            }
          }
        }
      ]
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "version", "artifact_ref", "sha256", "commit_sha", "tree_sha"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"},
        "commit_sha": {"$ref": "#/$defs/sha"}, "tree_sha": {"$ref": "#/$defs/sha"}
      }
    },
    "delegationBinding": {
      "type": "object", "additionalProperties": false,
      "$comment": "commit_sha/tree_sha bind artifact_ref; delegation_ref must equal artifact_ref plus '#' plus delegation_id and the delegate, role, action, subject, validity and revocation fields must all match the referenced record.",
      "required": [
        "delegation_id", "artifact_ref", "artifact_sha256", "commit_sha", "tree_sha",
        "grantor_human_identity_ref", "delegate_human_identity_ref",
        "authority_role", "action_ids", "subject_refs", "valid_from",
        "expires_at", "revoked_at", "evidence_refs"
      ],
      "properties": {
        "delegation_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]+$"},
        "artifact_ref": {"type": "string", "pattern": "^docs/00-governance/delegations/[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "commit_sha": {"$ref": "#/$defs/sha"},
        "tree_sha": {"$ref": "#/$defs/sha"},
        "grantor_human_identity_ref": {"type": "string", "minLength": 1},
        "delegate_human_identity_ref": {"type": "string", "minLength": 1},
        "authority_role": {"type": "string", "minLength": 1},
        "action_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "subject_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "valid_from": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "revoked_at": {"type": ["string", "null"], "format": "date-time"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "authorityActor": {
      "type": "object", "additionalProperties": false,
      "$comment": "role_binding_ref must resolve to the approved registry record identified by identity_subject at the bound commit/tree and sha256; human_identity_ref, provider subject and role must match that record.",
      "required": [
        "actor_kind", "human_identity_ref", "identity_provider",
        "identity_subject", "authority_role", "role_binding_ref",
        "role_binding_sha256", "role_binding_commit_sha",
        "role_binding_tree_sha", "role_binding_status",
        "authority_mode", "delegation_ref", "delegation_binding"
      ],
      "properties": {
        "actor_kind": {"const": "HUMAN"},
        "human_identity_ref": {"type": "string", "minLength": 1},
        "identity_provider": {"const": "bopen-authority-identity-registry"},
        "identity_subject": {"type": "string", "pattern": "^HUMAN-[A-Z0-9][A-Z0-9_-]*$"},
        "authority_role": {"type": "string", "minLength": 1},
        "role_binding_ref": {"type": "string", "pattern": "^docs/00-governance/registers/AUTHORITY-IDENTITY-REGISTER\\.json#[A-Z0-9][A-Z0-9_-]*$"},
        "role_binding_sha256": {"$ref": "#/$defs/sha256"},
        "role_binding_commit_sha": {"$ref": "#/$defs/sha"},
        "role_binding_tree_sha": {"$ref": "#/$defs/sha"},
        "role_binding_status": {"const": "approved"},
        "authority_mode": {"const": "DIRECT"},
        "delegation_ref": {
          "oneOf": [
            {"type": "string", "pattern": "^docs/00-governance/delegations/[A-Za-z0-9][A-Za-z0-9._/-]*\\.json#[A-Z][A-Z0-9_-]+$"},
            {"type": "null"}
          ]
        },
        "delegation_binding": {"oneOf": [{"$ref": "#/$defs/delegationBinding"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"authority_mode": {"const": "DIRECT"}}, "required": ["authority_mode"]},
          "then": {"properties": {"delegation_ref": {"type": "null"}, "delegation_binding": {"type": "null"}}}
        },
        {
          "$comment": "DELEGATED authority is not representable in this revision; delegation fields remain null placeholders for signed v0.4 compatibility."
        }
      ]
    },
    "concurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_role", "required", "source_refs", "bound_commit_sha", "bound_tree_sha", "authority_actor", "disposition", "decided_at", "expires_at", "evidence_refs"],
      "properties": {
        "authority_role": {"type": "string", "minLength": 1}, "required": {"const": true},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "bound_commit_sha": {"$ref": "#/$defs/sha"}, "bound_tree_sha": {"$ref": "#/$defs/sha"},
        "authority_actor": {"oneOf": [{"$ref": "#/$defs/authorityActor"}, {"type": "null"}]},
        "disposition": {"enum": ["PENDING", "CONCUR", "NONCONCUR", "DEFER", "WITHDRAW", "EXPIRE"]},
        "decided_at": {"type": ["string", "null"], "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "finalDisposition": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "decided_at", "reason_code", "decision_ref", "evidence_refs", "effective"],
      "properties": {
        "value": {"enum": ["PENDING", "APPROVE", "REJECT", "DEFER", "WITHDRAW", "EXPIRE"]},
        "decided_at": {"type": ["string", "null"], "format": "date-time"}, "reason_code": {"type": "string", "minLength": 1},
        "decision_ref": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "effective": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"value": {"const": "PENDING"}}, "required": ["value"]},
          "then": {
            "properties": {
              "decided_at": {"type": "null"},
              "decision_ref": {"type": "null"},
              "evidence_refs": {"maxItems": 0},
              "effective": {"const": false}
            }
          }
        },
        {
          "if": {
            "properties": {"value": {"enum": ["APPROVE", "REJECT", "DEFER", "WITHDRAW", "EXPIRE"]}},
            "required": ["value"]
          },
          "then": {
            "properties": {
              "decided_at": {"type": "string", "format": "date-time"},
              "decision_ref": {"type": "string", "minLength": 1},
              "evidence_refs": {"minItems": 1},
              "effective": {"const": true}
            }
          }
        }
      ]
    },
    "decisionRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "action_id", "subject", "prepared_by", "checked_by", "accountable_authority_role", "final_decision_role", "final_authority_actor", "required_concurrences", "expires_at", "final_disposition"],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^PG-G0-DEC-[0-9]{3}$"}, "action_id": {"type": "string", "minLength": 1},
        "subject": {"$ref": "#/$defs/subject"}, "prepared_by": {"$ref": "#/$defs/actor"},
        "checked_by": {"oneOf": [{"$ref": "#/$defs/actor"}, {"type": "null"}]},
        "accountable_authority_role": {"type": "string", "minLength": 1}, "final_decision_role": {"type": "string", "minLength": 1},
        "final_authority_actor": {"oneOf": [{"$ref": "#/$defs/authorityActor"}, {"type": "null"}]},
        "required_concurrences": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/concurrence"}},
        "expires_at": {"type": "string", "format": "date-time"},
        "prerequisite_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "final_disposition": {"$ref": "#/$defs/finalDisposition"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "final_disposition": {
                "properties": {"value": {"const": "PENDING"}},
                "required": ["value"]
              }
            },
            "required": ["final_disposition"]
          },
          "then": {"properties": {"checked_by": {"type": "null"}, "final_authority_actor": {"type": "null"}}}
        },
        {
          "if": {
            "properties": {
              "final_disposition": {
                "properties": {"value": {"enum": ["APPROVE", "REJECT", "DEFER", "WITHDRAW", "EXPIRE"]}},
                "required": ["value"]
              }
            },
            "required": ["final_disposition"]
          },
          "then": {
            "properties": {
              "checked_by": {"oneOf": [{"$ref": "#/$defs/actor"}, {"type": "null"}]},
              "final_authority_actor": {"$ref": "#/$defs/authorityActor"}
            }
          }
        }
      ]
    },
    "preparedDisposition": {
      "type": "object", "additionalProperties": false,
      "required": ["disposition_id", "batch_item", "action_id", "subject", "requested_state", "accountable_authority_role", "required_concurrence", "authority_actor", "concurrences", "disposition", "decided_at", "expires_at", "decision_ref", "evidence_refs", "effective"],
      "properties": {
        "disposition_id": {"type": "string", "pattern": "^PG-G0-PREP-[0-9]{3}$"},
        "batch_item": {"enum": ["B2", "B3", "B4", "B5", "B6"]},
        "action_id": {"enum": ["APPROVE_GOVERNANCE_BASELINE", "APPROVE_PROGRAM_REGISTERS", "ACCEPT_WORK_ITEM", "APPROVE_ARCHITECTURE"]},
        "subject": {"$ref": "#/$defs/subject"},
        "requested_state": {"enum": ["APPROVED", "ACCEPTED", "ACTIVE"]},
        "accountable_authority_role": {"type": "string", "minLength": 1},
        "required_concurrence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "authority_actor": {"$ref": "#/$defs/authorityActor"},
        "concurrences": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/preparedConcurrence"}},
        "disposition": {"const": "APPROVE"},
        "decided_at": {"const": "2026-07-23T00:45:00+07:00"},
        "expires_at": {"type": "string", "format": "date-time"},
        "decision_ref": {"const": "docs/00-governance/signing/SIGNING-PASS-2.md#append-only-batch-2-signing-record--2026-07-23"},
        "evidence_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "effective": {"const": true}
      }
    },
    "preparedConcurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_role", "authority_actor", "disposition", "decided_at", "decision_ref", "evidence_refs", "effective"],
      "properties": {
        "authority_role": {"type": "string", "minLength": 1},
        "authority_actor": {"$ref": "#/$defs/authorityActor"},
        "disposition": {"const": "CONCUR"},
        "decided_at": {"const": "2026-07-23T00:45:00+07:00"},
        "decision_ref": {"const": "docs/00-governance/signing/SIGNING-PASS-2.md#append-only-batch-2-signing-record--2026-07-23"},
        "evidence_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "effective": {"const": true}
      }
    },
    "stateHistory": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "from", "to", "changed_at", "changed_by", "reason_code", "commit_sha", "tree_sha", "evidence_refs"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1}, "from": {"type": ["string", "null"]}, "to": {"type": "string", "minLength": 1},
        "changed_at": {"type": "string", "format": "date-time"}, "changed_by": {"$ref": "#/$defs/actor"},
        "reason_code": {"type": "string", "minLength": 1}, "commit_sha": {"$ref": "#/$defs/sha"}, "tree_sha": {"$ref": "#/$defs/sha"},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "effectiveOutcome": {
      "type": "object", "additionalProperties": false,
      "required": ["program_goal_approved", "governance_baseline_approved", "work_package_accepted", "evidence_accepted", "ready_for_pg_g0_gate_decision"],
      "properties": {
        "program_goal_approved": {"const": true}, "governance_baseline_approved": {"const": true},
        "work_package_accepted": {"const": true}, "evidence_accepted": {"const": true},
        "ready_for_pg_g0_gate_decision": {"const": true}
      }
    },
    "nonAuthorityFlags": {
      "type": "object", "additionalProperties": false,
      "required": ["pg_g0_passed", "production_implementation_authorized", "merge_authorized", "release_authorized", "deployment_authorized", "runtime_activation_authorized", "module_certified", "skill_promoted"],
      "properties": {
        "pg_g0_passed": {"const": false}, "production_implementation_authorized": {"const": false},
        "merge_authorized": {"const": false}, "release_authorized": {"const": false},
        "deployment_authorized": {"const": false},
        "runtime_activation_authorized": {"const": false}, "module_certified": {"const": false}, "skill_promoted": {"const": false}
      }
    }
  },
  "additionalProperties": false
}
