{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bopen://schemas/governance/pg-g0-current-tree-readiness/0.1.0-draft",
  "status": "draft",
  "title": "bOPEN PG-G0 current-tree readiness projection",
  "description": "A non-authoritative projection that preserves historical blockers while recording bounded current-tree technical observations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "projection_id", "version", "status", "generated_at", "historical_view", "current_tree", "blocker_assessments", "summary", "authority", "limitation"],
  "properties": {
    "$schema": {"const": "bopen://schemas/governance/pg-g0-current-tree-readiness/0.1.0-draft"},
    "projection_id": {"const": "PG-G0-CURRENT-TREE-READINESS-001"},
    "version": {"const": "0.1.0-draft"},
    "status": {"const": "NOT_READY"},
    "generated_at": {"const": "2026-07-22T00:00:00+07:00"},
    "historical_view": {"$ref": "#/$defs/historicalView"},
    "current_tree": {"$ref": "#/$defs/currentTree"},
    "blocker_assessments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/blockerAssessment"}},
    "summary": {"$ref": "#/$defs/summary"},
    "authority": {"$ref": "#/$defs/authority"},
    "limitation": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "historicalView": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_ref", "artifact_sha256", "artifact_bytes", "docket_ref", "docket_sha256", "docket_bytes", "bound_commit_sha", "bound_tree_sha", "blocker_count"],
      "properties": {
        "artifact_ref": {"const": "artifacts/validation/program-g0-authority-readiness.json"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}, "artifact_bytes": {"type": "integer", "minimum": 1},
        "docket_ref": {"const": "docs/00-governance/authority-dockets/PG-G0-AUTH-001.json"},
        "docket_sha256": {"$ref": "#/$defs/sha256"}, "docket_bytes": {"type": "integer", "minimum": 1},
        "bound_commit_sha": {"$ref": "#/$defs/sha"}, "bound_tree_sha": {"$ref": "#/$defs/sha"},
        "blocker_count": {"type": "integer", "minimum": 1}
      }
    },
    "currentTree": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_ref", "evaluation_commit_sha", "evaluation_tree_sha", "evaluation_commit_is_ancestor", "root_controls_valid", "root_control_errors"],
      "properties": {
        "repository_ref": {"const": "bstBizEra/bopen"}, "evaluation_commit_sha": {"$ref": "#/$defs/sha"},
        "evaluation_tree_sha": {"$ref": "#/$defs/sha"}, "evaluation_commit_is_ancestor": {"type": "boolean"},
        "root_controls_valid": {"type": "boolean"}, "root_control_errors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "blockerAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["blocker_id", "original_text", "original_sha256", "classification", "current_observation", "machine_evidence_refs"],
      "properties": {
        "blocker_id": {"type": "string", "pattern": "^PG-G0-HIST-[0-9]{3}$"}, "original_text": {"type": "string", "minLength": 1},
        "original_sha256": {"$ref": "#/$defs/sha256"},
        "classification": {"enum": ["STILL_ACTIVE", "RESOLVED_TECHNICALLY_IN_CURRENT_TREE", "HUMAN_DISPOSITION_REQUIRED", "NOT_REEVALUABLE"]},
        "current_observation": {"type": "string", "minLength": 1},
        "machine_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["historical_blockers", "still_active", "resolved_technically_in_current_tree", "human_disposition_required", "not_reevaluable", "active_blockers", "ready_for_human_gate_decision"],
      "properties": {
        "historical_blockers": {"type": "integer", "minimum": 1}, "still_active": {"type": "integer", "minimum": 0},
        "resolved_technically_in_current_tree": {"type": "integer", "minimum": 0}, "human_disposition_required": {"type": "integer", "minimum": 0},
        "not_reevaluable": {"type": "integer", "minimum": 0}, "active_blockers": {"type": "integer", "minimum": 1},
        "ready_for_human_gate_decision": {"const": false}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["pg_g0_passed", "ready_for_human_gate_decision", "governance_baseline_approved", "work_package_accepted", "technology_approved", "identity_provider_approved", "qualification_executed", "merge_authorized", "release_authorized", "runtime_activation_authorized", "production_implementation_authorized"],
      "properties": {
        "pg_g0_passed": {"const": false}, "ready_for_human_gate_decision": {"const": false}, "governance_baseline_approved": {"const": false},
        "work_package_accepted": {"const": false}, "technology_approved": {"const": false}, "identity_provider_approved": {"const": false},
        "qualification_executed": {"const": false}, "merge_authorized": {"const": false}, "release_authorized": {"const": false},
        "runtime_activation_authorized": {"const": false}, "production_implementation_authorized": {"const": false}
      }
    }
  }
}
