{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bopen://schemas/governance/authority-matrix/0.2.0-draft",
  "status": "draft",
  "title": "bOPEN Authority Matrix v0.2",
  "type": "object",
  "required": ["$schema", "register_id", "version", "status", "owner_authority", "updated_at", "approved_by", "approved_at", "approval_ref", "entries"],
  "properties": {
    "$schema": {"const": "bopen://schemas/governance/authority-matrix/0.2.0-draft"},
    "register_id": {"const": "PG-REG-AUTHORITY-001"},
    "version": {"enum": ["0.2.0-draft", "0.2.0"]},
    "status": {"enum": ["draft", "approved"]},
    "owner_authority": {"const": "Engineering Authority"},
    "updated_at": {"type": "string", "format": "date-time"},
    "approved_by": {"type": ["string", "null"], "minLength": 1},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "approval_ref": {"type": ["string", "null"], "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["action_id", "action_class", "status", "accountable_human_authority", "permitted_maker_roles", "permitted_checker_roles", "required_concurrence", "final_decision_role", "self_approval_allowed", "evidence_required", "expiry_required"],
        "properties": {
          "action_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "action_class": {"type": "string", "minLength": 1},
          "status": {"enum": ["draft", "approved"]},
          "accountable_human_authority": {"type": "string", "minLength": 1},
          "permitted_maker_roles": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "permitted_checker_roles": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "required_concurrence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "final_decision_role": {"type": "string", "minLength": 1},
          "self_approval_allowed": {"const": false},
          "evidence_required": {"const": true},
          "expiry_required": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
      "then": {
        "properties": {
          "version": {"const": "0.2.0"},
          "approved_by": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "format": "date-time"},
          "approval_ref": {"type": "string", "minLength": 1},
          "entries": {"items": {"properties": {"status": {"const": "approved"}}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "draft"}}, "required": ["status"]},
      "then": {
        "properties": {
          "version": {"const": "0.2.0-draft"},
          "approved_by": {"const": null},
          "approved_at": {"const": null},
          "approval_ref": {"const": null},
          "entries": {"items": {"properties": {"status": {"const": "draft"}}}}
        }
      }
    }
  ],
  "additionalProperties": false
}
