{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "bopen://schemas/qualification/identity/migration-evidence-observation/0.1.0-draft", "status": "draft", "title": "Synthetic Identity Migration Evidence Qualification Observation", "description": "Synthetic qualification-only migration observation; not a runtime migration or cutover authorization.",
  "type": "object", "required": ["$schema", "record_id", "version", "status", "work_package_id", "qualification_id", "qualification_only", "synthetic_data_only", "qualification_envelope", "migration_evidence_id", "source_connection_ref", "target_connection_ref", "source_dataset_sha256", "target_dataset_sha256", "mode", "identity_mapping_strategy", "counts", "rollback_proof_sha256", "decision", "reason_codes", "correlation_id", "audit_event_ref", "determinism", "downstream_effects"],
  "properties": {
    "$schema": {"const": "bopen://schemas/qualification/identity/migration-evidence-observation/0.1.0-draft"}, "record_id": {"type": "string", "pattern": "^IDQ-MIG-[0-9]{3}$"}, "version": {"const": "0.1.0-draft"}, "status": {"const": "draft"}, "work_package_id": {"const": "QUAL-P0-02"}, "qualification_id": {"const": "DEC-0005-QUAL-001"}, "qualification_only": {"const": true}, "synthetic_data_only": {"const": true}, "qualification_envelope": {"$ref": "bopen://schemas/qualification/common/qualification-envelope/0.1.0-draft"},
    "migration_evidence_id": {"type": "string", "pattern": "^IDQ-MIG-[0-9]{3}$"}, "source_connection_ref": {"type": "string", "pattern": "^IDQ-CONNECTION-[A-Z0-9-]+$"}, "target_connection_ref": {"type": "string", "pattern": "^IDQ-CONNECTION-[A-Z0-9-]+$"}, "source_dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "target_dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "mode": {"enum": ["SYNTHETIC_DRY_RUN", "SYNTHETIC_CUTOVER_VERIFICATION", "SYNTHETIC_ROLLBACK_VERIFICATION"]}, "identity_mapping_strategy": {"const": "EXACT_ISSUER_AND_SUBJECT_ONLY"},
    "counts": {"type": "object", "required": ["input", "mapped", "unmapped", "ambiguous", "collisions"], "properties": {"input": {"type": "integer", "minimum": 0}, "mapped": {"type": "integer", "minimum": 0}, "unmapped": {"type": "integer", "minimum": 0}, "ambiguous": {"type": "integer", "minimum": 0}, "collisions": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "rollback_proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "decision": {"enum": ["ELIGIBLE_FOR_DECISION_INPUT", "BLOCKED", "REJECTED"]}, "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "correlation_id": {"type": "string", "minLength": 1}, "audit_event_ref": {"type": "string", "minLength": 1}, "determinism": {"$ref": "#/$defs/determinism"}, "downstream_effects": {"$ref": "#/$defs/downstreamEffects"}
  },
  "$defs": {"determinism": {"type": "object", "required": ["seed", "clock", "simulator_sha256"], "properties": {"seed": {"type": "integer", "minimum": 0}, "clock": {"type": "string", "format": "date-time"}, "simulator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}, "downstreamEffects": {"type": "object", "required": ["principal_runtime", "tenant", "membership", "role", "permission", "entitlement", "active_context", "release", "runtime_activation"], "properties": {"principal_runtime": {"const": "NONE"}, "tenant": {"const": "NONE"}, "membership": {"const": "NONE"}, "role": {"const": "NONE"}, "permission": {"const": "NONE"}, "entitlement": {"const": "NONE"}, "active_context": {"const": "NONE"}, "release": {"const": "NONE"}, "runtime_activation": {"const": "NONE"}}, "additionalProperties": false}}, "additionalProperties": false
}
