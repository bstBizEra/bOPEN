{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "bopen://schemas/qualification/identity/test-case-result-observation/0.1.0-draft", "status": "draft", "title": "Synthetic Identity Qualification Test Case Observation", "description": "Synthetic qualification-only execution observation, not a runtime contract; PASS is maker evidence and never independent acceptance.",
  "type": "object", "required": ["$schema", "record_id", "version", "status", "work_package_id", "qualification_id", "qualification_only", "synthetic_data_only", "qualification_envelope", "case_id", "requirement_refs", "category", "fixture_refs", "expected_decision", "actual_decision", "expected_reason_codes", "actual_reason_codes", "execution_result", "skipped", "log_sha256", "correlation_id", "audit_event_ref", "determinism", "downstream_effects"],
  "properties": {
    "$schema": {"const": "bopen://schemas/qualification/identity/test-case-result-observation/0.1.0-draft"}, "record_id": {"type": "string", "pattern": "^IDQ-CASE-[0-9]{3}$"}, "version": {"const": "0.1.0-draft"}, "status": {"const": "draft"}, "work_package_id": {"const": "QUAL-P0-02"}, "qualification_id": {"const": "DEC-0005-QUAL-001"}, "qualification_only": {"const": true}, "synthetic_data_only": {"const": true}, "qualification_envelope": {"$ref": "bopen://schemas/qualification/common/qualification-envelope/0.1.0-draft"},
    "case_id": {"type": "string", "pattern": "^IDQ-T[0-9]{3}$"}, "requirement_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PG-[A-Z0-9-]+$"}},
    "category": {"enum": ["OIDC_ISSUER_MIXUP", "ISSUER_NORMALIZATION", "SUBJECT_CASE", "SAME_EMAIL_CROSS_ISSUER", "SAME_SUBJECT_CROSS_ISSUER", "MISSING_SUBJECT", "WRONG_AUDIENCE", "WRONG_AUTHORIZED_PARTY", "ALG_NONE", "ALGORITHM_CONFUSION", "UNKNOWN_KEY_ID", "DUPLICATE_KEY_ID", "INVALID_SIGNATURE", "STALE_JWKS", "JWKS_ROTATION", "STATE_MISMATCH", "NONCE_MISMATCH", "PKCE_FAILURE", "CODE_REPLAY", "ASSERTION_REPLAY", "EXPIRED_ASSERTION", "FUTURE_ASSERTION", "DISABLED_PROVIDER", "REVOKED_BINDING", "INACTIVE_PRINCIPAL", "REVOKED_SESSION", "LINK_WITHOUT_DUAL_REAUTH", "LINK_CSRF", "SESSION_FIXATION", "KEY_ALREADY_BOUND", "CLAIM_TENANT_AUTHORITY", "RAW_SECRET_LEAK", "MIGRATION_AMBIGUITY", "MIGRATION_COLLISION", "MIGRATION_COUNT_MISMATCH", "MIGRATION_ROLLBACK_GAP"]},
    "fixture_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "expected_decision": {"enum": ["ALLOW_QUALIFICATION_ONLY", "DENY", "BLOCKED"]}, "actual_decision": {"enum": ["ALLOW_QUALIFICATION_ONLY", "DENY", "BLOCKED"]}, "expected_reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reasonCode"}}, "actual_reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reasonCode"}}, "execution_result": {"enum": ["PASS", "FAIL", "BLOCKED"]}, "skipped": {"const": false}, "log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "correlation_id": {"type": "string", "minLength": 1}, "audit_event_ref": {"type": "string", "minLength": 1}, "determinism": {"$ref": "#/$defs/determinism"}, "downstream_effects": {"$ref": "#/$defs/downstreamEffects"}
  },
  "$defs": {
    "reasonCode": {"enum": ["ACCOUNT_LINK_CSRF_DETECTED", "ACCOUNT_LINK_EXPLICIT_CONFIRMATION_REQUIRED", "AUTHN_ALGORITHM_NOT_ALLOWED", "AUTHN_ASSERTION_EXPIRED", "AUTHN_ASSERTION_NOT_YET_VALID", "AUTHN_AUDIENCE_MISMATCH", "AUTHN_AUTHORIZED_PARTY_MISMATCH", "AUTHN_ISSUER_MISMATCH", "AUTHN_JWKS_STALE", "AUTHN_KEY_AMBIGUOUS", "AUTHN_KEY_NOT_FOUND", "AUTHN_NONCE_MISMATCH", "AUTHN_PKCE_FAILED", "AUTHN_PROVIDER_DISABLED", "AUTHN_REPLAY_DETECTED", "AUTHN_SIGNATURE_INVALID", "AUTHN_STATE_MISMATCH", "AUTHN_SUBJECT_MISSING", "CLAIM_AUTHORITY_PROHIBITED", "EVIDENCE_REDACTION_VIOLATION", "IDENTITY_BINDING_COLLISION", "IDENTITY_BINDING_REVOKED", "IDENTITY_EXACT_KEY_DISTINCT", "MIGRATION_AMBIGUOUS_MAPPING", "MIGRATION_COLLISION", "MIGRATION_COUNT_MISMATCH", "MIGRATION_ROLLBACK_UNPROVEN", "PRINCIPAL_INACTIVE", "QUALIFICATION_BLOCKED", "QUALIFICATION_OBSERVATION_PASS", "SESSION_FIXATION_DETECTED", "SESSION_REVOKED"]},
    "determinism": {"type": "object", "required": ["seed", "clock", "simulator_sha256"], "properties": {"seed": {"type": "integer", "minimum": 0}, "clock": {"type": "string", "format": "date-time"}, "simulator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "downstreamEffects": {"type": "object", "required": ["principal_runtime", "tenant", "membership", "role", "permission", "entitlement", "active_context", "release", "runtime_activation"], "properties": {"principal_runtime": {"const": "NONE"}, "tenant": {"const": "NONE"}, "membership": {"const": "NONE"}, "role": {"const": "NONE"}, "permission": {"const": "NONE"}, "entitlement": {"const": "NONE"}, "active_context": {"const": "NONE"}, "release": {"const": "NONE"}, "runtime_activation": {"const": "NONE"}}, "additionalProperties": false}
  }, "additionalProperties": false
}
