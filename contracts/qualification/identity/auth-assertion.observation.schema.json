{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bopen://schemas/qualification/identity/auth-assertion-observation/0.1.0-draft",
  "status": "draft", "title": "Synthetic OIDC Authentication Assertion Qualification Observation", "description": "Synthetic qualification-only observation containing digests, never a raw token or runtime assertion.",
  "type": "object",
  "required": ["$schema", "record_id", "version", "status", "work_package_id", "qualification_id", "candidate_id", "qualification_only", "synthetic_data_only", "qualification_envelope", "assertion_id", "provider_connection_id", "token_sha256", "raw_token_present", "identity_key", "header", "audience_sha256", "authorized_party_sha256", "issued_at", "not_before", "expires_at", "authentication_time", "state_sha256", "nonce_sha256", "pkce_verifier_sha256", "replay_cache_key_sha256", "checks", "decision", "reason_codes", "correlation_id", "audit_event_ref", "determinism", "downstream_effects"],
  "properties": {
    "$schema": {"const": "bopen://schemas/qualification/identity/auth-assertion-observation/0.1.0-draft"}, "record_id": {"type": "string", "pattern": "^IDQ-ASSERT-[0-9]{3}$"}, "version": {"const": "0.1.0-draft"}, "status": {"const": "draft"}, "work_package_id": {"const": "QUAL-P0-02"}, "qualification_id": {"const": "DEC-0005-QUAL-001"}, "candidate_id": {"type": "string", "pattern": "^IDQ-CANDIDATE-[A-Z0-9-]+$"}, "qualification_only": {"const": true}, "synthetic_data_only": {"const": true}, "qualification_envelope": {"$ref": "bopen://schemas/qualification/common/qualification-envelope/0.1.0-draft"},
    "assertion_id": {"type": "string", "pattern": "^IDQ-ASSERT-[0-9]{3}$"}, "provider_connection_id": {"type": "string", "pattern": "^IDQ-CONNECTION-[A-Z0-9-]+$"}, "token_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "raw_token_present": {"const": false},
    "identity_key": {"$ref": "#/$defs/identityKey"}, "header": {"type": "object", "required": ["algorithm", "key_id"], "properties": {"algorithm": {"enum": ["RS256", "PS256", "ES256", "NONE", "UNSUPPORTED"]}, "key_id": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "audience_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "authorized_party_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "issued_at": {"type": "string", "format": "date-time"}, "not_before": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "authentication_time": {"type": "string", "format": "date-time"},
    "state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "nonce_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "pkce_verifier_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "replay_cache_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["check_id", "result", "reason_code"], "properties": {"check_id": {"enum": ["ISSUER", "SUBJECT", "SIGNATURE", "ALGORITHM", "KEY_ID", "AUDIENCE", "AUTHORIZED_PARTY", "STATE", "NONCE", "PKCE", "ISSUED_AT", "NOT_BEFORE", "EXPIRY", "REPLAY", "PROVIDER_LIFECYCLE"]}, "result": {"enum": ["PASS", "DENY"]}, "reason_code": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "decision": {"enum": ["ALLOW_QUALIFICATION_ONLY", "DENY"]}, "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "correlation_id": {"type": "string", "minLength": 1}, "audit_event_ref": {"type": "string", "minLength": 1}, "determinism": {"$ref": "#/$defs/determinism"}, "downstream_effects": {"$ref": "#/$defs/downstreamEffects"}
  },
  "$defs": {
    "identityKey": {"type": "object", "required": ["issuer_uri", "subject", "canonicalization", "issuer_subject_sha256"], "properties": {"issuer_uri": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]+)?(?:/[A-Za-z0-9._~!$&'()*+,;=:@%-]*)*$"}, "subject": {"type": "string", "minLength": 1, "maxLength": 255}, "canonicalization": {"const": "RFC8785_EXACT_ISSUER_AND_SUBJECT"}, "issuer_subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "determinism": {"type": "object", "required": ["seed", "clock", "simulator_sha256"], "properties": {"seed": {"type": "integer", "minimum": 0}, "clock": {"type": "string", "format": "date-time"}, "simulator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "downstreamEffects": {"type": "object", "required": ["principal_runtime", "tenant", "membership", "role", "permission", "entitlement", "active_context", "release", "runtime_activation"], "properties": {"principal_runtime": {"const": "NONE"}, "tenant": {"const": "NONE"}, "membership": {"const": "NONE"}, "role": {"const": "NONE"}, "permission": {"const": "NONE"}, "entitlement": {"const": "NONE"}, "active_context": {"const": "NONE"}, "release": {"const": "NONE"}, "runtime_activation": {"const": "NONE"}}, "additionalProperties": false}
  }, "additionalProperties": false
}
