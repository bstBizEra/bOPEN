{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "bopen://schemas/qualification/identity/assurance-evidence-observation/0.1.0-draft", "status": "draft", "title": "Synthetic Authentication Assurance Qualification Observation", "description": "Synthetic qualification-only assurance observation; not a runtime assurance grant.",
  "type": "object", "required": ["$schema", "record_id", "version", "status", "work_package_id", "qualification_id", "qualification_only", "synthetic_data_only", "qualification_envelope", "assurance_evidence_id", "assertion_ref", "policy_id", "policy_sha256", "observed_acr", "observed_amr", "authentication_time", "freshness_seconds", "evaluation", "reason_codes", "correlation_id", "audit_event_ref", "determinism", "downstream_effects"],
  "properties": {
    "$schema": {"const": "bopen://schemas/qualification/identity/assurance-evidence-observation/0.1.0-draft"}, "record_id": {"type": "string", "pattern": "^IDQ-ASSURANCE-[0-9]{3}$"}, "version": {"const": "0.1.0-draft"}, "status": {"const": "draft"}, "work_package_id": {"const": "QUAL-P0-02"}, "qualification_id": {"const": "DEC-0005-QUAL-001"}, "qualification_only": {"const": true}, "synthetic_data_only": {"const": true}, "qualification_envelope": {"$ref": "bopen://schemas/qualification/common/qualification-envelope/0.1.0-draft"},
    "assurance_evidence_id": {"type": "string", "pattern": "^IDQ-ASSURANCE-[0-9]{3}$"}, "assertion_ref": {"type": "string", "pattern": "^IDQ-ASSERT-[0-9]{3}$"}, "policy_id": {"type": "string", "minLength": 1}, "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "observed_acr": {"type": "string", "minLength": 1}, "observed_amr": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "authentication_time": {"type": "string", "format": "date-time"}, "freshness_seconds": {"type": "integer", "minimum": 0}, "evaluation": {"enum": ["SATISFIES_QUALIFICATION_POLICY", "INSUFFICIENT", "INDETERMINATE"]}, "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "correlation_id": {"type": "string", "minLength": 1}, "audit_event_ref": {"type": "string", "minLength": 1}, "determinism": {"$ref": "#/$defs/determinism"}, "downstream_effects": {"$ref": "#/$defs/downstreamEffects"}
  },
  "$defs": {"determinism": {"type": "object", "required": ["seed", "clock", "simulator_sha256"], "properties": {"seed": {"type": "integer", "minimum": 0}, "clock": {"type": "string", "format": "date-time"}, "simulator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}, "downstreamEffects": {"type": "object", "required": ["principal_runtime", "tenant", "membership", "role", "permission", "entitlement", "active_context", "release", "runtime_activation"], "properties": {"principal_runtime": {"const": "NONE"}, "tenant": {"const": "NONE"}, "membership": {"const": "NONE"}, "role": {"const": "NONE"}, "permission": {"const": "NONE"}, "entitlement": {"const": "NONE"}, "active_context": {"const": "NONE"}, "release": {"const": "NONE"}, "runtime_activation": {"const": "NONE"}}, "additionalProperties": false}}, "additionalProperties": false
}
