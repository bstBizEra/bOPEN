{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bopen://schemas/qualification/identity/provider-connection-observation/0.1.0-draft",
  "status": "draft",
  "title": "Synthetic OIDC Provider Connection Qualification Observation",
  "description": "Synthetic qualification-only observation; not a runtime connection or provider approval contract.",
  "type": "object",
  "required": ["$schema", "record_id", "version", "status", "work_package_id", "qualification_id", "candidate_id", "qualification_only", "synthetic_data_only", "qualification_envelope", "provider_connection_id", "issuer_uri", "identity_key_policy", "lifecycle_status", "allowed_signing_algorithms", "discovery_metadata_sha256", "jwks_snapshot_sha256", "rotation_policy", "claim_authority", "credential_material_present", "correlation_id", "audit_event_ref", "determinism", "downstream_effects"],
  "properties": {
    "$schema": {"const": "bopen://schemas/qualification/identity/provider-connection-observation/0.1.0-draft"},
    "record_id": {"type": "string", "pattern": "^IDQ-PC-[0-9]{3}$"},
    "version": {"const": "0.1.0-draft"},
    "status": {"const": "draft"},
    "work_package_id": {"const": "QUAL-P0-02"},
    "qualification_id": {"const": "DEC-0005-QUAL-001"},
    "candidate_id": {"type": "string", "pattern": "^IDQ-CANDIDATE-[A-Z0-9-]+$"},
    "qualification_only": {"const": true},
    "synthetic_data_only": {"const": true},
    "qualification_envelope": {"$ref": "bopen://schemas/qualification/common/qualification-envelope/0.1.0-draft"},
    "provider_connection_id": {"type": "string", "pattern": "^IDQ-CONNECTION-[A-Z0-9-]+$"},
    "issuer_uri": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]+)?(?:/[A-Za-z0-9._~!$&'()*+,;=:@%-]*)*$"},
    "identity_key_policy": {"const": "EXACT_ISSUER_AND_SUBJECT"},
    "lifecycle_status": {"enum": ["SYNTHETIC_ENABLED", "SYNTHETIC_DISABLED"]},
    "allowed_signing_algorithms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["RS256", "PS256", "ES256"]}},
    "discovery_metadata_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "jwks_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rotation_policy": {
      "type": "object",
      "required": ["rotation_required", "unknown_kid_denied", "duplicate_kid_denied", "stale_key_denied", "overlap_seconds"],
      "properties": {
        "rotation_required": {"const": true},
        "unknown_kid_denied": {"const": true},
        "duplicate_kid_denied": {"const": true},
        "stale_key_denied": {"const": true},
        "overlap_seconds": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "claim_authority": {
      "type": "object",
      "required": ["email_linking_authorized", "domain_linking_authorized", "group_linking_authorized", "role_linking_authorized", "tenant_authority_authorized"],
      "properties": {
        "email_linking_authorized": {"const": false},
        "domain_linking_authorized": {"const": false},
        "group_linking_authorized": {"const": false},
        "role_linking_authorized": {"const": false},
        "tenant_authority_authorized": {"const": false}
      },
      "additionalProperties": false
    },
    "credential_material_present": {"const": false},
    "correlation_id": {"type": "string", "minLength": 1},
    "audit_event_ref": {"type": "string", "minLength": 1},
    "determinism": {"$ref": "#/$defs/determinism"},
    "downstream_effects": {"$ref": "#/$defs/downstreamEffects"}
  },
  "$defs": {
    "determinism": {"type": "object", "required": ["seed", "clock", "simulator_sha256"], "properties": {"seed": {"type": "integer", "minimum": 0}, "clock": {"type": "string", "format": "date-time"}, "simulator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "downstreamEffects": {"type": "object", "required": ["principal_runtime", "tenant", "membership", "role", "permission", "entitlement", "active_context", "release", "runtime_activation"], "properties": {"principal_runtime": {"const": "NONE"}, "tenant": {"const": "NONE"}, "membership": {"const": "NONE"}, "role": {"const": "NONE"}, "permission": {"const": "NONE"}, "entitlement": {"const": "NONE"}, "active_context": {"const": "NONE"}, "release": {"const": "NONE"}, "runtime_activation": {"const": "NONE"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
