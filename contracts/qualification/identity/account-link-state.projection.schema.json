{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "bopen://schemas/qualification/identity/account-link-state-projection/0.1.0-draft", "status": "draft", "title": "Synthetic Account Link State Qualification Projection", "description": "Synthetic qualification-only append-oriented projection; not a runtime account-link authorization.",
  "type": "object", "required": ["$schema", "record_id", "version", "status", "work_package_id", "qualification_id", "qualification_only", "synthetic_data_only", "qualification_envelope", "link_event_id", "link_id", "sequence", "previous_event_sha256", "identity_key", "target_principal_id", "from_state", "to_state", "link_method", "proof_assertion_refs", "proof_session_ref", "claim_authority", "decision", "reason_codes", "correlation_id", "audit_event_ref", "determinism", "downstream_effects"],
  "properties": {
    "$schema": {"const": "bopen://schemas/qualification/identity/account-link-state-projection/0.1.0-draft"}, "record_id": {"type": "string", "pattern": "^IDQ-LINK-[0-9]{3}$"}, "version": {"const": "0.1.0-draft"}, "status": {"const": "draft"}, "work_package_id": {"const": "QUAL-P0-02"}, "qualification_id": {"const": "DEC-0005-QUAL-001"}, "qualification_only": {"const": true}, "synthetic_data_only": {"const": true}, "qualification_envelope": {"$ref": "bopen://schemas/qualification/common/qualification-envelope/0.1.0-draft"},
    "link_event_id": {"type": "string", "pattern": "^IDQ-LINK-[0-9]{3}$"}, "link_id": {"type": "string", "pattern": "^IDQ-LINKAGE-[A-Z0-9-]+$"}, "sequence": {"type": "integer", "minimum": 1}, "previous_event_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "identity_key": {"$ref": "#/$defs/identityKey"}, "target_principal_id": {"type": "string", "pattern": "^synthetic-principal-[a-z0-9-]+$"},
    "from_state": {"enum": ["UNLINKED", "PENDING_EXPLICIT_PROOF", "SYNTHETIC_LINKED", "SYNTHETIC_REVOKED"]}, "to_state": {"enum": ["PENDING_EXPLICIT_PROOF", "SYNTHETIC_LINKED", "SYNTHETIC_REJECTED", "SYNTHETIC_REVOKED"]}, "link_method": {"enum": ["FIRST_SIGN_IN_CREATE", "EXPLICIT_DUAL_REAUTHENTICATION", "APPROVED_ADMIN_RECOVERY_SIMULATION", "MIGRATION_EXACT_KEY", "PROHIBITED_CLAIM_MATCH"]}, "proof_assertion_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^IDQ-ASSERT-[0-9]{3}$"}}, "proof_session_ref": {"type": ["string", "null"], "pattern": "^IDQ-SESSION-[0-9]{3}$"}, "claim_authority": {"$ref": "#/$defs/claimAuthority"}, "decision": {"enum": ["PROJECT_LINK_QUALIFICATION_ONLY", "DENY_LINK"]}, "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "correlation_id": {"type": "string", "minLength": 1}, "audit_event_ref": {"type": "string", "minLength": 1}, "determinism": {"$ref": "#/$defs/determinism"}, "downstream_effects": {"$ref": "#/$defs/downstreamEffects"}
  },
  "$defs": {
    "identityKey": {"type": "object", "required": ["issuer_uri", "subject", "canonicalization", "issuer_subject_sha256"], "properties": {"issuer_uri": {"type": "string", "pattern": "^https://"}, "subject": {"type": "string", "minLength": 1, "maxLength": 255}, "canonicalization": {"const": "RFC8785_EXACT_ISSUER_AND_SUBJECT"}, "issuer_subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "claimAuthority": {"type": "object", "required": ["email_linking_authorized", "domain_linking_authorized", "group_linking_authorized", "role_linking_authorized", "tenant_authority_authorized"], "properties": {"email_linking_authorized": {"const": false}, "domain_linking_authorized": {"const": false}, "group_linking_authorized": {"const": false}, "role_linking_authorized": {"const": false}, "tenant_authority_authorized": {"const": false}}, "additionalProperties": false},
    "determinism": {"type": "object", "required": ["seed", "clock", "simulator_sha256"], "properties": {"seed": {"type": "integer", "minimum": 0}, "clock": {"type": "string", "format": "date-time"}, "simulator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "downstreamEffects": {"type": "object", "required": ["principal_runtime", "tenant", "membership", "role", "permission", "entitlement", "active_context", "release", "runtime_activation"], "properties": {"principal_runtime": {"const": "NONE"}, "tenant": {"const": "NONE"}, "membership": {"const": "NONE"}, "role": {"const": "NONE"}, "permission": {"const": "NONE"}, "entitlement": {"const": "NONE"}, "active_context": {"const": "NONE"}, "release": {"const": "NONE"}, "runtime_activation": {"const": "NONE"}}, "additionalProperties": false}
  }, "additionalProperties": false
}
