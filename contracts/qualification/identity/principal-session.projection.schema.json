{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "bopen://schemas/qualification/identity/principal-session-projection/0.1.0-draft", "status": "draft", "title": "Synthetic Principal Session Qualification Projection", "description": "Synthetic qualification-only projection; not a runtime session, credential, membership or tenant context.",
  "type": "object", "required": ["$schema", "record_id", "version", "status", "work_package_id", "qualification_id", "candidate_id", "qualification_only", "synthetic_data_only", "qualification_envelope", "session_projection_id", "principal_id", "principal_lifecycle_status", "identity_binding_ref", "assertion_ref", "assurance_ref", "session_state", "issued_at", "expires_at", "revoked_at", "creation_decision", "reason_codes", "tenant_context_ref", "raw_credential_present", "correlation_id", "audit_event_ref", "determinism", "downstream_effects"],
  "properties": {
    "$schema": {"const": "bopen://schemas/qualification/identity/principal-session-projection/0.1.0-draft"}, "record_id": {"type": "string", "pattern": "^IDQ-SESSION-[0-9]{3}$"}, "version": {"const": "0.1.0-draft"}, "status": {"const": "draft"}, "work_package_id": {"const": "QUAL-P0-02"}, "qualification_id": {"const": "DEC-0005-QUAL-001"}, "candidate_id": {"type": "string", "pattern": "^IDQ-CANDIDATE-[A-Z0-9-]+$"}, "qualification_only": {"const": true}, "synthetic_data_only": {"const": true}, "qualification_envelope": {"$ref": "bopen://schemas/qualification/common/qualification-envelope/0.1.0-draft"},
    "session_projection_id": {"type": "string", "pattern": "^IDQ-SESSION-[0-9]{3}$"}, "principal_id": {"type": "string", "pattern": "^synthetic-principal-[a-z0-9-]+$"}, "principal_lifecycle_status": {"enum": ["SYNTHETIC_ACTIVE", "SYNTHETIC_SUSPENDED", "SYNTHETIC_DELETED"]}, "identity_binding_ref": {"type": "string", "pattern": "^IDQ-IDENTITY-[A-Z0-9-]+$"}, "assertion_ref": {"type": "string", "pattern": "^IDQ-ASSERT-[0-9]{3}$"}, "assurance_ref": {"type": "string", "pattern": "^IDQ-ASSURANCE-[0-9]{3}$"},
    "session_state": {"enum": ["SYNTHETIC_PROJECTED", "SYNTHETIC_DENIED", "SYNTHETIC_REVOKED", "SYNTHETIC_EXPIRED"]}, "issued_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "revoked_at": {"type": ["string", "null"], "format": "date-time"}, "creation_decision": {"enum": ["PROJECT_QUALIFICATION_SESSION", "DO_NOT_PROJECT_SESSION"]}, "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "tenant_context_ref": {"type": "null"}, "raw_credential_present": {"const": false}, "correlation_id": {"type": "string", "minLength": 1}, "audit_event_ref": {"type": "string", "minLength": 1}, "determinism": {"$ref": "#/$defs/determinism"}, "downstream_effects": {"$ref": "#/$defs/downstreamEffects"}
  },
  "$defs": {"determinism": {"type": "object", "required": ["seed", "clock", "simulator_sha256"], "properties": {"seed": {"type": "integer", "minimum": 0}, "clock": {"type": "string", "format": "date-time"}, "simulator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}, "downstreamEffects": {"type": "object", "required": ["principal_runtime", "tenant", "membership", "role", "permission", "entitlement", "active_context", "release", "runtime_activation"], "properties": {"principal_runtime": {"const": "NONE"}, "tenant": {"const": "NONE"}, "membership": {"const": "NONE"}, "role": {"const": "NONE"}, "permission": {"const": "NONE"}, "entitlement": {"const": "NONE"}, "active_context": {"const": "NONE"}, "release": {"const": "NONE"}, "runtime_activation": {"const": "NONE"}}, "additionalProperties": false}}, "additionalProperties": false
}
