{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bopen://schemas/qualification/technology/command-evidence/0.1.0-draft",
  "status": "draft",
  "title": "bOPEN Technology Qualification Command Evidence",
  "type": "object",
  "required": ["$schema", "command_evidence_id", "version", "status", "work_package_id", "qualification_run_id", "candidate_id", "case_id", "argv", "working_directory", "started_at", "completed_at", "exit_code", "stdout_artifact", "stderr_artifact", "environment_manifest", "secret_scan_passed", "synthetic_data_only", "deterministic_replay", "non_authority_flags"],
  "properties": {
    "$schema": {"const": "bopen://schemas/qualification/technology/command-evidence/0.1.0-draft"},
    "command_evidence_id": {"type": "string", "pattern": "^TECH-CMD-[0-9]{3}$"},
    "version": {"const": "0.1.0-draft"},
    "status": {"const": "draft"},
    "work_package_id": {"const": "TECH-P0-01"},
    "qualification_run_id": {"type": "string", "pattern": "^TECH-RUN-[0-9]{3}$"},
    "candidate_id": {"type": "string", "pattern": "^TECH-CAND-[0-9]{3}$"},
    "case_id": {"type": "string", "pattern": "^TECH-CASE-[0-9]{3}$"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "working_directory": {"$ref": "bopen://schemas/qualification/common/normalized-path/0.1.0-draft"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "exit_code": {"type": "integer"},
    "stdout_artifact": {"$ref": "bopen://schemas/qualification/common/digest-binding/0.1.0-draft"},
    "stderr_artifact": {"$ref": "bopen://schemas/qualification/common/digest-binding/0.1.0-draft"},
    "environment_manifest": {"$ref": "bopen://schemas/qualification/common/digest-binding/0.1.0-draft"},
    "secret_scan_passed": {"const": true},
    "synthetic_data_only": {"const": true},
    "deterministic_replay": {"const": true},
    "non_authority_flags": {"$ref": "bopen://schemas/qualification/common/qualification-envelope/0.1.0-draft#/$defs/nonAuthorityFlags"}
  },
  "additionalProperties": false
}
