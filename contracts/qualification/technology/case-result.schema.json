{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bopen://schemas/qualification/technology/case-result/0.1.0-draft",
  "status": "draft",
  "title": "bOPEN Technology Qualification Case Result",
  "type": "object",
  "required": ["$schema", "case_id", "version", "status", "work_package_id", "qualification_run_id", "candidate_id", "category", "mandatory", "result", "requirement_ids", "command_evidence_refs", "artifact_refs", "negative_case", "limitation", "non_authority_flags"],
  "properties": {
    "$schema": {"const": "bopen://schemas/qualification/technology/case-result/0.1.0-draft"},
    "case_id": {"type": "string", "pattern": "^TECH-CASE-[0-9]{3}$"},
    "version": {"const": "0.1.0-draft"},
    "status": {"const": "draft"},
    "work_package_id": {"const": "TECH-P0-01"},
    "qualification_run_id": {"type": "string", "pattern": "^TECH-RUN-[0-9]{3}$"},
    "candidate_id": {"type": "string", "pattern": "^TECH-CAND-[0-9]{3}$"},
    "category": {"enum": ["TENANT_RLS_NEGATIVE", "TENANT_POOL_NEGATIVE", "TENANT_CONTEXT_NEGATIVE", "OBSERVABILITY", "OUTBOX", "RECOVERY", "SUPPLY_CHAIN", "OTHER_PROGRAM_GOAL"]},
    "mandatory": {"type": "boolean"},
    "result": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
    "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PG-[A-Z0-9-]+$"}},
    "command_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "bopen://schemas/qualification/common/normalized-path/0.1.0-draft"}},
    "artifact_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "bopen://schemas/qualification/common/digest-binding/0.1.0-draft"}},
    "negative_case": {"type": "boolean"},
    "limitation": {"type": "string", "minLength": 1},
    "non_authority_flags": {"$ref": "bopen://schemas/qualification/common/qualification-envelope/0.1.0-draft#/$defs/nonAuthorityFlags"}
  },
  "additionalProperties": false
}
