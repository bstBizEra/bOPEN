{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bopen://schemas/qualification/technology/candidate-scorecard/0.1.0-draft",
  "status": "draft",
  "title": "bOPEN Technology Candidate Proposal Scorecard",
  "type": "object",
  "required": ["$schema", "scorecard_id", "version", "status", "work_package_id", "qualification_run_id", "candidate_id", "candidate_name", "vendor_disposition", "common_catalog_binding", "program_goal_catalog_binding", "mandatory_criteria", "weighted_criteria", "program_goal_coverage", "weighted_score", "recommendation", "limitations", "non_authority_flags"],
  "properties": {
    "$schema": {"const": "bopen://schemas/qualification/technology/candidate-scorecard/0.1.0-draft"},
    "scorecard_id": {"type": "string", "pattern": "^TECH-SCORE-[0-9]{3}$"},
    "version": {"const": "0.1.0-draft"},
    "status": {"const": "draft"},
    "work_package_id": {"const": "TECH-P0-01"},
    "qualification_run_id": {"type": "string", "pattern": "^TECH-RUN-[0-9]{3}$"},
    "candidate_id": {"type": "string", "pattern": "^TECH-CAND-[0-9]{3}$"},
    "candidate_name": {"type": "string", "minLength": 1},
    "vendor_disposition": {"const": "UNDECIDED"},
    "common_catalog_binding": {"$ref": "bopen://schemas/qualification/common/digest-binding/0.1.0-draft"},
    "program_goal_catalog_binding": {"$ref": "bopen://schemas/qualification/common/digest-binding/0.1.0-draft"},
    "mandatory_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/mandatoryCriterion"}},
    "weighted_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/weightedCriterion"}},
    "program_goal_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverage"}},
    "weighted_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "recommendation": {"enum": ["PROPOSAL_ONLY", "NOT_QUALIFIED"]},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "non_authority_flags": {"$ref": "bopen://schemas/qualification/common/qualification-envelope/0.1.0-draft#/$defs/nonAuthorityFlags"}
  },
  "$defs": {
    "mandatoryCriterion": {
      "type": "object",
      "required": ["criterion_id", "case_ids", "requirement_ids", "result", "failure_reason"],
      "properties": {
        "criterion_id": {"type": "string", "pattern": "^MAND-[A-Z0-9-]+$"},
        "case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TECH-CASE-[0-9]{3}$"}},
        "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PG-[A-Z0-9-]+$"}},
        "result": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "failure_reason": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": false
    },
    "weightedCriterion": {
      "type": "object",
      "required": ["criterion_id", "weight", "score", "case_ids", "limitation"],
      "properties": {
        "criterion_id": {"type": "string", "pattern": "^WEIGHT-[A-Z0-9-]+$"},
        "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TECH-CASE-[0-9]{3}$"}},
        "limitation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["requirement_id", "coverage_level", "case_ids", "coverage_limit"],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^PG-[A-Z0-9-]+$"},
        "coverage_level": {"enum": ["DIRECT", "PARTIAL", "DEFERRED", "NOT_COVERED"]},
        "case_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TECH-CASE-[0-9]{3}$"}},
        "coverage_limit": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
