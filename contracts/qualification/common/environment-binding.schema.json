{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bopen://schemas/qualification/common/environment-binding/0.1.0-draft",
  "status": "draft",
  "title": "bOPEN Qualification Environment Binding",
  "type": "object",
  "required": ["environment_id", "manifest_ref", "manifest_sha256", "os_family", "os_version", "architecture", "locale", "timezone", "network_mode", "runner_kind", "runner_image_digest", "toolchain", "captured_at"],
  "properties": {
    "environment_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "manifest_ref": {"$ref": "bopen://schemas/qualification/common/normalized-path/0.1.0-draft"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "os_family": {"enum": ["WINDOWS", "LINUX", "MACOS", "OTHER"]},
    "os_version": {"type": "string", "minLength": 1},
    "architecture": {"type": "string", "minLength": 1},
    "locale": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "network_mode": {"enum": ["OFFLINE", "LOOPBACK_ONLY", "ALLOWLISTED"]},
    "runner_kind": {"enum": ["HOST", "CONTAINER", "VM"]},
    "runner_image_digest": {
      "oneOf": [
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "toolchain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "executable_sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "captured_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
