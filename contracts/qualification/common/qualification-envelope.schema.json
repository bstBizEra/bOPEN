{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bopen://schemas/qualification/common/qualification-envelope/0.1.0-draft",
  "status": "draft",
  "title": "bOPEN Common Qualification Envelope",
  "type": "object",
  "required": [
    "$schema", "envelope_id", "version", "status", "work_package_id",
    "qualification_run_id", "subject_repository_binding", "environment_binding",
    "provenance", "redaction", "evidence_root", "artifact_inventory_ref",
    "requirement_bindings", "governing_artifact_bindings", "adr_bindings",
    "authority_binding", "execution_scope", "exception_refs", "coverage_claims",
    "gate_context", "created_at", "non_authority_flags"
  ],
  "properties": {
    "$schema": {"const": "bopen://schemas/qualification/common/qualification-envelope/0.1.0-draft"},
    "envelope_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-ENV-[0-9]{3}$"},
    "version": {"const": "0.1.0-draft"},
    "status": {"const": "draft"},
    "work_package_id": {"type": "string", "pattern": "^[A-Z]+-P[0-9]+-[0-9]{2}$"},
    "qualification_run_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-RUN-[0-9]{3}$"},
    "subject_repository_binding": {"$ref": "bopen://schemas/qualification/common/repository-binding/0.1.0-draft"},
    "environment_binding": {"$ref": "bopen://schemas/qualification/common/environment-binding/0.1.0-draft"},
    "provenance": {"$ref": "bopen://schemas/qualification/common/provenance/0.1.0-draft"},
    "redaction": {"$ref": "bopen://schemas/qualification/common/redaction/0.1.0-draft"},
    "evidence_root": {"$ref": "bopen://schemas/qualification/common/normalized-path/0.1.0-draft"},
    "artifact_inventory_ref": {"$ref": "bopen://schemas/qualification/common/digest-binding/0.1.0-draft"},
    "requirement_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/controlledBinding"}},
    "governing_artifact_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/controlledBinding"}},
    "adr_bindings": {"type": "array", "items": {"$ref": "#/$defs/controlledBinding"}},
    "authority_binding": {"$ref": "#/$defs/authorityBinding"},
    "execution_scope": {"$ref": "#/$defs/executionScope"},
    "exception_refs": {"type": "array", "items": {"$ref": "#/$defs/exceptionRef"}},
    "coverage_claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverageClaim"}},
    "gate_context": {"$ref": "#/$defs/gateContext"},
    "created_at": {"type": "string", "format": "date-time"},
    "non_authority_flags": {"$ref": "#/$defs/nonAuthorityFlags"}
  },
  "$defs": {
    "controlledBinding": {
      "type": "object",
      "required": ["artifact_id", "version", "status", "artifact_ref", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "artifact_ref": {"$ref": "bopen://schemas/qualification/common/normalized-path/0.1.0-draft"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "authorityBinding": {
      "type": "object",
      "required": ["authorization_status", "authority_source_ref", "authority_source_sha256", "accepted_by", "accepted_at", "expires_at", "authority_effective"],
      "properties": {
        "authorization_status": {"enum": ["PROPOSED", "ACCEPTED", "EXPIRED", "REVOKED"]},
        "authority_source_ref": {"$ref": "bopen://schemas/qualification/common/normalized-path/0.1.0-draft"},
        "authority_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "accepted_by": {"oneOf": [{"$ref": "bopen://schemas/qualification/common/provenance/0.1.0-draft#/$defs/actor"}, {"type": "null"}]},
        "accepted_at": {"type": ["string", "null"], "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "authority_effective": {"const": false}
      },
      "additionalProperties": false
    },
    "executionScope": {
      "type": "object",
      "required": ["branch_ref", "worktree_ref", "base_repository_binding", "allowed_paths", "prohibited_paths"],
      "properties": {
        "branch_ref": {"type": "string", "minLength": 1},
        "worktree_ref": {"type": "string", "minLength": 1},
        "base_repository_binding": {"$ref": "bopen://schemas/qualification/common/repository-binding/0.1.0-draft"},
        "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "bopen://schemas/qualification/common/normalized-path/0.1.0-draft"}},
        "prohibited_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "bopen://schemas/qualification/common/normalized-path/0.1.0-draft"}}
      },
      "additionalProperties": false
    },
    "exceptionRef": {
      "type": "object",
      "required": ["exception_id", "status", "artifact_ref", "sha256", "expires_at"],
      "properties": {
        "exception_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["PENDING", "ACTIVE", "EXPIRED", "REVOKED"]},
        "artifact_ref": {"$ref": "bopen://schemas/qualification/common/normalized-path/0.1.0-draft"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "expires_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "coverageClaim": {
      "type": "object",
      "required": ["requirement_id", "coverage_level", "evidence_refs", "coverage_limit"],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^PG-[A-Z0-9-]+$"},
        "coverage_level": {"enum": ["DIRECT", "PARTIAL", "DEFERRED", "NOT_COVERED"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "coverage_limit": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "gateContext": {
      "type": "object",
      "required": ["gate_id", "prerequisites", "gate_effective"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^PG-(?:G|P|C)[0-9]+$"},
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["requirement_id", "status", "evidence_refs"],
            "properties": {
              "requirement_id": {"type": "string", "pattern": "^PG-[A-Z0-9-]+$"},
              "status": {"enum": ["EFFECTIVE", "PENDING", "MISSING", "FAILED"]},
              "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        },
        "gate_effective": {"const": false}
      },
      "additionalProperties": false
    },
    "nonAuthorityFlags": {
      "type": "object",
      "required": ["technology_stack_approved", "technology_stack_frozen", "identity_provider_approved", "pg_g0_passed", "production_implementation_authorized", "merge_authorized", "release_authorized", "runtime_activation_authorized", "authority_effective"],
      "properties": {
        "technology_stack_approved": {"const": false},
        "technology_stack_frozen": {"const": false},
        "identity_provider_approved": {"const": false},
        "pg_g0_passed": {"const": false},
        "production_implementation_authorized": {"const": false},
        "merge_authorized": {"const": false},
        "release_authorized": {"const": false},
        "runtime_activation_authorized": {"const": false},
        "authority_effective": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
