{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bopen://schemas/qualification/common/offline-catalog/0.1.0-draft",
  "status": "draft",
  "title": "bOPEN Closed Offline Schema Catalog",
  "type": "object",
  "required": ["$schema", "catalog_id", "version", "status", "work_package_id", "updated_at", "imports", "entries"],
  "properties": {
    "$schema": {"const": "bopen://schemas/qualification/common/offline-catalog/0.1.0-draft"},
    "catalog_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-SCHEMA-CATALOG$"},
    "version": {"const": "0.1.0-draft"},
    "status": {"const": "draft"},
    "work_package_id": {"type": "string", "pattern": "^[A-Z]+-P[0-9]+-[0-9]{2}$"},
    "updated_at": {"type": "string", "format": "date-time"},
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["catalog_id", "path", "sha256"],
        "properties": {
          "catalog_id": {"type": "string", "minLength": 1},
          "path": {"$ref": "bopen://schemas/qualification/common/normalized-path/0.1.0-draft"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_id", "path", "sha256"],
        "properties": {
          "schema_id": {"type": "string", "pattern": "^bopen://schemas/qualification/[a-z0-9._/-]+$"},
          "path": {"$ref": "bopen://schemas/qualification/common/normalized-path/0.1.0-draft"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
