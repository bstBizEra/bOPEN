{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bopen.io/schemas/v1/context-switch.json",
  "title": "ContextSwitch",
  "version": "1.0.0",
  "description": "Request and response contract for POST /v1/session/context:switch v1.0.0. Governing artifacts BOPEN-IDP-001 section 13.1 and BOPEN-P2-001 section 11.2. Header values are untrusted selectors and are never authorization evidence.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "required": ["tenant_id", "idempotency_key"],
      "properties": {
        "tenant_id": { "type": "string", "description": "Requested tenant; untrusted selector" },
        "expected_context_id": { "type": ["string", "null"], "description": "Expected current context correlation identifier" },
        "idempotency_key": { "type": "string" }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["context_id", "tenant_id", "membership_id", "expires_at"],
      "properties": {
        "context_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "membership_id": { "type": "string" },
        "access_token": { "type": "string", "description": "Returned only through the approved token channel; never logged or evidenced" },
        "expires_at": { "type": "string", "format": "date-time" },
        "delegated_grant_id": { "type": ["string", "null"], "description": "Present only for delegated context" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
