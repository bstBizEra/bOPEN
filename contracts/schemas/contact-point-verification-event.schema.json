{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bopen.io/schemas/candidate/contact-point-verification-event.json",
  "title": "ContactPointVerificationEventCandidate",
  "version": "0.1.0",
  "status": "draft",
  "description": "CANDIDATE append-only verification evidence. Rows are immutable, retained on ContactPoint retirement, and protected by delete restriction. No raw endpoint value or globally reusable digest is permitted.",
  "type": "object",
  "required": [
    "event_id",
    "tenant_id",
    "party_id",
    "contact_point_id",
    "endpoint_version",
    "event_type",
    "from_state",
    "to_state",
    "verification_method",
    "actor_type",
    "actor_id",
    "reason_code",
    "correlation_id",
    "occurred_at"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "party_id": { "type": "string", "minLength": 1 },
    "contact_point_id": { "type": "string", "pattern": "^cpt_[a-zA-Z0-9_-]+$" },
    "endpoint_version": { "type": "integer", "minimum": 1 },
    "event_type": {
      "type": "string",
      "enum": ["verification_started", "verified", "verification_failed", "invalidated", "expired"]
    },
    "from_state": { "type": "string", "enum": ["unverified", "pending", "verified", "failed", "expired"] },
    "to_state": { "type": "string", "enum": ["unverified", "pending", "verified", "failed", "expired"] },
    "verification_method": {
      "type": "string",
      "enum": ["administrative_assertion", "otp", "magic_link", "system_invalidation", "system_expiry"],
      "description": "Administrative assertion is distinguishable from challenged verification. OTP and magic-link ceremonies remain deferred until separately authorized."
    },
    "actor_type": { "type": "string", "enum": ["principal", "service"] },
    "actor_id": { "type": "string", "minLength": 1 },
    "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "correlation_id": { "type": "string", "minLength": 1 },
    "causation_id": { "type": ["string", "null"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "evidence_reference": {
      "type": ["string", "null"],
      "description": "Opaque reference to governed evidence, never the endpoint or a verification secret."
    }
  },
  "additionalProperties": false
}
