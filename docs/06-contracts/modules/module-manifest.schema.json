{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bopen://schemas/module-manifest/0.1.0-draft",
  "status": "draft",
  "title": "bOPEN Module Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "status",
    "capabilities",
    "resources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "deprecated"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "object"
    },
    "entitlements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agents": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
