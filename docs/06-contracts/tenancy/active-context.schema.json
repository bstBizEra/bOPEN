{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bopen://schemas/tenancy/active-context/0.1.0-draft",
  "status": "draft",
  "title": "Active Tenant Context",
  "description": "A server-validated principal, tenant, and membership context used as an authorization input.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_id",
    "principal_id",
    "tenant_id",
    "membership_id",
    "status",
    "validation_source",
    "issued_at",
    "expires_at",
    "correlation_id"
  ],
  "properties": {
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "membership_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["active", "expired", "revoked"]
    },
    "validation_source": {
      "enum": ["server_session", "trusted_service"]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
