{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bopen://schemas/tenancy/tenant-ownership/0.1.0-draft",
  "status": "draft",
  "title": "Tenant-Owned Resource Envelope",
  "description": "The minimum ownership metadata required for a tenant-owned resource contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "resource_type",
    "resource_id",
    "ownership_version"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_type": {
      "type": "string",
      "minLength": 1
    },
    "resource_id": {
      "type": "string",
      "minLength": 1
    },
    "ownership_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
