{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bopen://schemas/tenancy/membership/0.1.0-draft",
  "status": "draft",
  "title": "Tenant Membership",
  "description": "A principal-to-tenant relationship. Membership is not a role, permission, job title, or entitlement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "membership_id",
    "principal_id",
    "tenant_id",
    "state",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "membership_id": {
      "type": "string",
      "minLength": 1
    },
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "invited",
        "active",
        "suspended",
        "declined",
        "expired",
        "revoked",
        "left",
        "removed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
