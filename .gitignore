# Node & Package Build Dependencies
node_modules/
.pnpm-store/
.turbo/
dist/
build/
coverage/
.pytest_cache/
__pycache__/
*.pyc

# Local Environments & Virtualenvs
.env
.env.*
!.env.example
.venv/
venv/
env/

# Editors & Operating System Files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Clean-Room Research Clones (Never commit unapproved external source)
research/upstream/*
!research/upstream/README.md
!research/upstream/.gitkeep

# Generated Validation Evidence & Scratch Artifacts
artifacts/validation/*
!artifacts/validation/README.md
artifacts/scratch/
artifacts/audit-output/

# Local Vector DBs, Databases & AST Indexes
graphify-out/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/ruvector.db

# Agent Handoffs & Transient Coordination Files
/HANDOFF-*.md
/HANDOFF-*-TO-*.md
*.log
*.tmp

# Agent Runtime State Directories (Keep on disk, never commit)
/.claude/
/.claude-flow/
/.swarm/
/.codex/
/.gemini/

# Transient upstream documents fetched by research tooling into the working tree.
# AGENTS.md §6 prohibits committing upstream source outside research/upstream/; these
# patterns make that prohibition unbreakable by accident rather than relying on care.
/*.html
/*.pdf
/*.txt
!/README.txt
